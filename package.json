{
  "name": "libreria-estudio-backend",
  "version": "1.0.0",
  "description": "API REST /api/v1 para Librería Estudio con arquitectura de 5 capas, reservas atómicas de stock, cotizador de listas escolares y checkout ACID.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "node --test tests/*.test.js",
    "verificar": "find src -name \"*.js\" -print0 | xargs -0 -n1 node --check && npm run lint"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  }
}
