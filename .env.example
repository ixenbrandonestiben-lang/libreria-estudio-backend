# ==============================================================================
# Librería Estudio - Backend API (.env.example)
# Copia este archivo a .env y reemplaza los valores de ejemplo antes de iniciar.
# NUNCA subas el archivo .env real al repositorio.
# ==============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --- Base de Datos (MySQL 8.0) ---
# En Docker Compose usa "mysql-db" como host (ya fijado en docker-compose.yml); en local usa "127.0.0.1"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=libreria_estudio
DB_USER=libreria_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
DB_POOL_LIMIT=10

# --- Seguridad y Autenticación ---
# Genera un secreto seguro con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_HEX
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# --- CORS y Rate Limiting ---
# Lista separada por comas de orígenes permitidos en producción
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Observabilidad ---
LOG_LEVEL=info
